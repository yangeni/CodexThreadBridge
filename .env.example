CTB_PROJECT_ROOT=/absolute/path/to/CodexThreadBridge
ILINK_BASE_URL=https://ilink.example.test/bot
ILINK_BOT_TOKEN=replace-with-ilink-bot-token
ILINK_OWNER_USER_IDS=wechat-owner-id-1,wechat-owner-id-2
ILINK_POLL_TIMEOUT_SECONDS=35
ILINK_REQUEST_TIMEOUT_SECONDS=30
CTB_CONTROLLER_COMMAND=/usr/bin/env,PYTHONPATH=/absolute/path/to/cross-thread-controller/src,CROSS_THREAD_CONTROLLER_DB=/absolute/path/to/cross-thread-controller/state.sqlite3,python3,-m,cross_thread_controller.mcp_server
